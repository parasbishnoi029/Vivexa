{
  "name": "react-example",
  "private": true,
  "version": "0.0.0",
  "description": "Enterprise-grade AI Decision Intelligence Platform powered by a React + Vite + TypeScript + Tailwind CSS frontend, Node.js/Express backend, PostgreSQL/Supabase database, and Google Gemini AI.",
  "type": "module",
  "scripts": {
    "dev": "tsx server.ts",
    "prebuild": "node scripts/generate-sitemap.js",
    "build": "vite build && esbuild server.ts --bundle --platform=node --format=cjs --packages=external --sourcemap --outfile=dist/server.cjs",
    "start": "node dist/server.cjs",
    "clean": "rm -rf dist server.js",
    "lint": "tsc --noEmit"
  },
