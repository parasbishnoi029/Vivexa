# 🚨 REAL EMAIL DELIVERY SETUP (Transition out of Development Sandbox mode)
# To receive actual booking and registration emails in your Gmail inbox, configure ONE of the options below:
# Allowed values: smtp | resend | sendgrid | mailgun | ses (If empty, defaults to Development Sandbox log mode)
EMAIL_PROVIDER=smtp

# --- OPTION A-1: Brevo SMTP Configuration (Recommended for high-deliverability) ---
# For Brevo SMTP:
# 1. Sign in to your Brevo Dashboard (formerly Sendinblue).
# 2. Go to "SMTP & API" from the top-right menu.
# 3. Choose the "SMTP" tab to locate your master SMTP Key/Password.
SMTP_HOST=smtp-relay.brevo.com
SMTP_PORT=587
SMTP_USER=your-registered-brevo-email@domain.com
SMTP_PASSWORD=your_master_brevo_smtp_key_here
FROM_EMAIL=your-verified-brevo-sender@domain.com
FROM_NAME=Vivexa Platforms
REPLY_TO_EMAIL=info.vivexa@gmail.com

# --- OPTION A-2: Gmail SMTP Configuration (Alternative option) ---
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=info.vivexa@gmail.com
# SMTP_PASSWORD=xxxx-xxxx-xxxx-xxxx

# --- OPTION B: Resend Configuration (High-deliverability alternate) ---
# RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxx

# --- OPTION C: SendGrid Configuration ---
# SENDGRID_API_KEY=SG.xxxxxxxxxxxxxxxxxxxxxxxx

# --- OPTION D: Mailgun Configuration ---
# MAILGUN_API_KEY=key-xxxxxxxxxxxxxxxxxxxxxxxx
# MAILGUN_DOMAIN=mg.yourdomain.com

